# =============================================================================
# Confer Marketing Generator — Environment Variables
# Copy this file to .env and fill in your actual keys.
# =============================================================================

# --- LiteLLM / Refiner ---
CONFER_LITELLM_API_KEY=sk-your-openai-or-proxy-key
# Optional: custom LiteLLM proxy URL (e.g. https://litellm.confersolutions.ai/v1)
CONFER_LITELLM_BASE_URL=https://litellm.confersolutions.ai/v1
CONFER_LITELLM_MODEL=gpt-5-nano

# --- Image Providers ---
OPENAI_API_KEY=sk-your-openai-key      # DALL-E 3
REPLICATE_API_KEY=r8_your-key          # Flux, Stable Diffusion 3
IDEOGRAM_API_KEY=your-ideogram-key     # Ideogram
GOOGLE_API_KEY=your-google-key         # Gemini / Imagen 3
STABILITY_API_KEY=sk-your-stability-key # Stable Diffusion 3 (via Stability AI)

# --- Video Providers ---
RUNWAY_API_KEY=rw_your-key             # Runway Gen-4
LUMA_API_KEY=lm_your-key              # Luma Dream Machine
PIKA_API_KEY=your-pika-key            # Pika
ADOBE_API_KEY=your-adobe-key          # Adobe Firefly Video
HEYGEN_API_KEY=your-heygen-key        # HeyGen
