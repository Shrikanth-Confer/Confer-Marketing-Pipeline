# ─── Confer Marketing Generator — Environment Variables ────────────────────
# Copy to .env and fill in the keys you have.
# Pollinations.ai requires NO key at all.

# LiteLLM / Refiner (built-in, no user action needed)
CONFER_LITELLM_MODEL=gpt-5-nano
CONFER_LITELLM_BASE_URL=https://litellm.confersolutions.ai/v1
CONFER_LITELLM_API_KEY=your-litellm-key-here

# ─── Free-tier provider keys ──────────────────────────────────────────────
# Get free keys at the URLs shown in MODELS.md

CONFER_TOGETHER_API_KEY=
CONFER_GOOGLE_API_KEY=
CONFER_CLOUDFLARE_ACCOUNT_ID=
CONFER_CLOUDFLARE_API_TOKEN=
CONFER_XAI_API_KEY=
CONFER_HUGGINGFACE_API_KEY=
CONFER_DEEPAI_API_KEY=
CONFER_REPLICATE_API_KEY=
CONFER_FAL_API_KEY=
CONFER_ELEVENLABS_API_KEY=
