# =============================================================================
# Confer Marketing Generator — Environment Variables
# Copy this file to .env and fill in your actual keys.
# =============================================================================

# --- LiteLLM / Refiner ---
CONFER_LITELLM_API_KEY=sk-your-openai-or-proxy-key
# Optional: custom LiteLLM proxy URL (e.g. https://litellm.confersolutions.ai/v1)
CONFER_LITELLM_BASE_URL=https://litellm.confersolutions.ai/v1
CONFER_LITELLM_MODEL=gpt-5-nano

# --- Image Providers ---
CONFER_OPENAI_API_KEY=sk-your-openai-key      # DALL-E 3, GPT Image 1
CONFER_BFL_API_KEY=your-bfl-key               # Flux 2 Pro/Dev/Schnell (api.bfl.ai)
CONFER_REPLICATE_API_KEY=r8_your-key          # Replicate-hosted models
CONFER_IDEOGRAM_API_KEY=your-ideogram-key     # Ideogram v3
CONFER_GOOGLE_API_KEY=your-google-key         # Google Imagen 3
CONFER_STABILITY_API_KEY=sk-your-stability-key # SD3.5 Large

# --- Video Providers ---
CONFER_RUNWAY_API_KEY=rw_your-key             # Runway Gen-4
CONFER_LUMA_API_KEY=lm_your-key              # Luma Dream Machine
CONFER_PIKA_API_KEY=your-pika-key            # Pika
CONFER_ADOBE_API_KEY=your-adobe-key          # Adobe Firefly Video
CONFER_HEYGEN_API_KEY=your-heygen-key        # HeyGen

# --- New Phase 10 Providers ---
CONFER_FAL_API_KEY=your-fal-key              # Fal.ai (Kling, Wan, LTX, AnimateDiff)
CONFER_MODELSLAB_API_KEY=your-modelslab-key  # ModelsLab (Seedance)
CONFER_WAVESPEED_API_KEY=your-wavespeed-key  # WaveSpeed (Seedream, Kling, Wan)
CONFER_SYNTHESIA_API_KEY=your-synthesia-key  # Synthesia (Avatar video)
